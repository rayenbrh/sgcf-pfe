{
  "name": "sgcf-pfe",
  "private": true,
  "version": "1.0.0",
  "description": "SGCF — frontend + backend",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "overrides": {
    "vite-plugin-pwa": {
      "vite": "^8.0.0"
    }
  },
  "dependencies": {
    "axios": "^1.7.9"
  },
  "scripts": {
    "dev:frontend": "npm run dev -w ./frontend",
    "dev:backend": "npm run dev -w ./backend",
    "dev": "concurrently -n frontend,backend -c cyan,magenta \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build": "npm run build -w ./frontend && npm run build -w ./backend",
    "seed": "npm run seed -w ./backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
